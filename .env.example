# Copy this file to .env and add your Gemini API key.
GEMINI_API_KEY=

# Current Gemini models. You can change these without changing Python code.
GEMINI_WORKOUT_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# Set to true to run without an API key. Useful for UI/database testing.
DEMO_MODE=true

# SQLite database file.
DATABASE_URL=sqlite:///./fitbuddy.db

# App settings.
APP_NAME=FitBuddy
ADMIN_TITLE=FitBuddy Admin

# Development server.
HOST=127.0.0.1
PORT=8000
